<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Jobs - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar', {user, activePage: 'jobs', search}) %>
    
    <main class="container">
        <div class="page-header">
            <h1>Available Job Positions</h1>
            <p>Find your next career opportunity from our curated list of jobs</p>
        </div>

        <% if (lastVisit) { %>
            <div class="last-visit">
                <p>Your last visit: <%= lastVisit %></p>
            </div>
        <% } %>

        <% if (search) { %>
            <div class="search-results">
                <p>Search results for: "<strong><%= search %></strong>"</p>
                <a href="/jobs" class="btn btn-secondary">Clear Search</a>
            </div>
        <% } %>

        <div class="jobs-grid">
            <% if (jobs && jobs.length > 0) { %>
                <% jobs.forEach(job => { %>
                    <div class="job-card">
                        <div class="job-header">
                            <h3><%= job.jobDesignation %></h3>
                            <span class="company-badge"><%= job.companyName %></span>
                        </div>
                        
                        <div class="job-details">
                            <div class="detail-item">
                                <span class="icon">📍</span>
                                <span><%= job.jobLocation %></span>
                            </div>
                            <div class="detail-item">
                                <span class="icon">💰</span>
                                <span>$<%= job.salary %></span>
                            </div>
                            <div class="detail-item">
                                <span class="icon">⏰</span>
                                <span>Apply by: <%= new Date(job.applyBy).toLocaleDateString() %></span>
                            </div>
                        </div>

                        <div class="skills-section">
                            <strong>Skills:</strong>
                            <div class="skills-list">
                                <% job.skillsRequired.forEach(skill => { %>
                                    <span class="skill-tag"><%= skill %></span>
                                <% }); %>
                            </div>
                        </div>

                        <div class="job-actions">
                            <a href="/jobs/<%= job.id %>" class="btn btn-primary">View Details</a>
                            <a href="/jobs/<%= job.id %>/apply" class="btn btn-secondary">Apply Now</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-jobs">
                    <h3>No jobs available at the moment</h3>
                    <p>Check back later or try a different search term</p>
                </div>
            <% } %>
        </div>

        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (hasPrev) { %>
                    <a href="/jobs?page=<%= currentPage - 1 %>" class="page-link">← Previous</a>
                <% } %>
                
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/jobs?page=<%= i %>" class="page-link <%= i === currentPage ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
                
                <% if (hasNext) { %>
                    <a href="/jobs?page=<%= currentPage + 1 %>" class="page-link">Next →</a>
                <% } %>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
