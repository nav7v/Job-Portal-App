<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Job - Job Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar', {user, activePage: 'create'}) %>
    
    <main class="container">
        <div class="form-container">
            <h2>Create New Job Posting</h2>
            
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-error">
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <form action="/jobs/create" method="POST" class="job-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="jobDesignation">Job Title *</label>
                        <input type="text" id="jobDesignation" name="jobDesignation" required 
                               value="<%= formData ? formData.jobDesignation : '' %>">
                    </div>

                    <div class="form-group">
                        <label for="companyName">Company Name *</label>
                        <input type="text" id="companyName" name="companyName" required 
                               value="<%= formData ? formData.companyName : '' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="jobLocation">Job Location *</label>
                        <input type="text" id="jobLocation" name="jobLocation" required 
                               value="<%= formData ? formData.jobLocation : '' %>">
                    </div>

                    <div class="form-group">
                        <label for="salary">Salary *</label>
                        <input type="text" id="salary" name="salary" required 
                               value="<%= formData ? formData.salary : '' %>" placeholder="e.g., 50000">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="applyBy">Application Deadline *</label>
                        <input type="date" id="applyBy" name="applyBy" required 
                               value="<%= formData ? formData.applyBy : '' %>">
                    </div>

                    <div class="form-group">
                        <label for="numberOfOpenings">Number of Openings *</label>
                        <input type="number" id="numberOfOpenings" name="numberOfOpenings" required min="1" 
                               value="<%= formData ? formData.numberOfOpenings : '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="skillsRequired">Required Skills *</label>
                    <input type="text" id="skillsRequired" name="skillsRequired" required 
                           value="<%= formData ? formData.skillsRequired : '' %>" 
                           placeholder="e.g., JavaScript, React, Node.js (comma separated)">
                </div>

                <div class="form-group">
                    <label for="jobCategory">Job Category *</label>
                    <select id="jobCategory" name="jobCategory" required>
                        <option value="">Select Category</option>
                        <option value="Full-time" <%= formData && formData.jobCategory === 'Full-time' ? 'selected' : '' %>>Full-time</option>
                        <option value="Part-time" <%= formData && formData.jobCategory === 'Part-time' ? 'selected' : '' %>>Part-time</option>
                        <option value="Contract" <%= formData && formData.jobCategory === 'Contract' ? 'selected' : '' %>>Contract</option>
                        <option value="Internship" <%= formData && formData.jobCategory === 'Internship' ? 'selected' : '' %>>Internship</option>
                        <option value="Remote" <%= formData && formData.jobCategory === 'Remote' ? 'selected' : '' %>>Remote</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary btn-full">Create Job Posting</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
