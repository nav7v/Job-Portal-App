<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applicants - <%= job.jobDesignation %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar', {user, activePage: 'jobs'}) %>
    
    <main class="container">
        <div class="applicants-container">
            <div class="applicants-header">
                <h1>Applicants for <%= job.jobDesignation %></h1>
                <p>Company: <%= job.companyName %></p>
                <a href="/jobs" class="btn btn-secondary">Back to Jobs</a>
            </div>

            <% if (applicants && applicants.length > 0) { %>
                <div class="applicants-list">
                    <% applicants.forEach(applicant => { %>
                        <div class="applicant-card">
                            <div class="applicant-info">
                                <h3><%= applicant.name %></h3>
                                <p class="applicant-email">📧 <%= applicant.email %></p>
                                <p class="applicant-contact">📞 <%= applicant.contact %></p>
                                <p class="applicant-date">Applied: <%= new Date(applicant.appliedAt).toLocaleDateString() %></p>
                            </div>
                            
                            <div class="applicant-actions">
                                <% if (applicant.resumePath) { %>
                                    <a href="<%= applicant.resumePath %>" target="_blank" class="btn btn-primary">View Resume</a>
                                <% } else { %>
                                    <span class="no-resume">No resume uploaded</span>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="no-applicants">
                    <h3>No applicants yet</h3>
                    <p>No one has applied for this job position yet.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
